#!/usr/bin/env bash
set -euo pipefail

launcher_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
repo_dir=$(cd -- "$launcher_dir/.." && pwd)
config_dir=${XDG_CONFIG_HOME:-"$HOME/.config"}/scriptorium
state_dir=${XDG_STATE_HOME:-"$HOME/.local/state"}/scriptorium
preferences_file=$config_dir/preferences
if [[ -f $launcher_dir/scriptorium-preferences.sh ]]; then
    source "$launcher_dir/scriptorium-preferences.sh"
elif [[ -f $repo_dir/scripts/preferences.sh ]]; then
    source "$repo_dir/scripts/preferences.sh"
else
    printf 'scodex: managed preference parser is unavailable.\n' >&2
    exit 1
fi

review_pending_tools() {
    local pending_tools=$state_dir/tools-reconfigure-required
    local tools_manager=$repo_dir/scripts/tools-manager.sh
    local tools_env=$config_dir/tools-env.sh pending_names
    [[ -s $pending_tools && $(read_pref "$preferences_file" tools 0) == 1 ]] || return 0
    pending_names=$(paste -sd, "$pending_tools")
    printf 'scodex: new optional tools require your selection: %s\n' "$pending_names"
    if [[ -t 0 && -t 1 && -x $tools_manager ]]; then
        if "$tools_manager" configure --review "$pending_names"; then
            "$repo_dir/codex/scripts/render-agents.sh"
            rm -f -- "$pending_tools"
            source "$tools_env"
        else
            printf 'scodex: tool selection remains pending; Codex will continue\n' >&2
        fi
    else
        printf 'scodex: run `scodex tools configure` in a terminal to review the tool list\n'
    fi
}

reconcile_tool_catalog() {
    local tools_manager=$repo_dir/scripts/tools-manager.sh
    if [[ -x $tools_manager && $(read_pref "$preferences_file" tools 0) == 1 ]]; then
        "$tools_manager" reconcile || true
    fi
}

configured_repo=$(read_pref "$preferences_file" repo_dir "")
if [[ -n $configured_repo ]]; then
    repo_dir=$configured_repo
    if [[ ! -d $repo_dir/.git ]]; then
        printf 'scodex: configured repository is invalid: %s\n' "$repo_dir" >&2
        exit 1
    fi
fi

case ${1:-} in
    update)
        SCRIPTORIUM_MANUAL_UPDATE=1 \
            SCRIPTORIUM_SKIP_SNOOZE_CHECK=1 \
            "$repo_dir/scripts/update-repository.sh" apply || true
        reconcile_tool_catalog
        review_pending_tools
        exit 0
        ;;
    configure)
        shift
        "$repo_dir/install.sh" "$@"
        exit $?
        ;;
    uninstall)
        shift
        exec "$repo_dir/uninstall.sh" "$@"
        ;;
    tools)
        shift
        tools_manager=$repo_dir/scripts/tools-manager.sh
        if [[ -x $tools_manager ]]; then
            tools_action=${1:-status}
            "$tools_manager" "$@"
            case $tools_action in
                configure|update|remove|clear)
                    "$repo_dir/codex/scripts/render-agents.sh"
                    ;;
            esac
            exit 0
        fi
        printf 'scodex: tools manager is not available.\n'
        exit 1
        ;;
esac

skip_update=0
if [[ ${1:-} == --no-update ]]; then
    skip_update=1
    shift
fi

profile=hard
case ${1:-} in
    --cheap|cheap) profile=cheap; shift ;;
    --normal|normal) profile=normal; shift ;;
    --hard|hard) profile=hard; shift ;;
esac

tools_env=$config_dir/tools-env.sh
if [[ -f $tools_env ]]; then
    source "$tools_env"
else
    export SCRIPTORIUM_ACTIVE=1 SCRIPTORIUM_TOOLS=
fi

if (( ! skip_update )) && [[ $(read_pref "$preferences_file" update_check "$(read_pref "$preferences_file" auto_update 1)") != 0 ]]; then
    SCRIPTORIUM_MANUAL_UPDATE=1 "$repo_dir/scripts/update-repository.sh" check || true
fi

tools_manager=$repo_dir/scripts/tools-manager.sh
reconcile_tool_catalog
review_pending_tools

if [[ -x $tools_manager ]]; then
    "$tools_manager" check || true
fi

if ! command -v codex >/dev/null 2>&1; then
    printf 'scodex: codex is not installed or is missing from PATH.\n' >&2
    exit 127
fi

exec codex --profile "scriptorium-$profile" "$@"
