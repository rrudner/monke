#!/usr/bin/env bash
set -euo pipefail

launcher_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
repo_dir=$(cd -- "$launcher_dir/.." && pwd)
config_dir=${XDG_CONFIG_HOME:-"$HOME/.config"}/scriptorium
state_dir=${XDG_STATE_HOME:-"$HOME/.local/state"}/scriptorium
preferences_file=$config_dir/preferences
tools_env=$config_dir/tools-env.sh
if [[ -f $launcher_dir/scriptorium-preferences.sh ]]; then
    source "$launcher_dir/scriptorium-preferences.sh"
elif [[ -f $repo_dir/scripts/preferences.sh ]]; then
    source "$repo_dir/scripts/preferences.sh"
else
    printf 'scodex: managed preference parser is unavailable.\n' >&2
    exit 1
fi

load_tools_env() {
    if [[ -f $tools_env ]]; then
        source "$tools_env"
    else
        export SCRIPTORIUM_ACTIVE=1 SCRIPTORIUM_TOOLS=
    fi
}

toml_basic_string() {
    local value=$1
    value=${value//\\/\\\\}
    value=${value//\"/\\\"}
    value=${value//$'\n'/\\n}
    value=${value//$'\r'/\\r}
    value=${value//$'\t'/\\t}
    printf '"%s"' "$value"
}

load_developer_instructions() {
    # A literal ~/ prefix is expanded below without evaluating the configured value.
    # shellcheck disable=SC2088
    local configured_path=$1 resolved_path content body tilde_prefix='~/'
    [[ -n $configured_path ]] || return 1
    case $configured_path in
        /*) resolved_path=$configured_path ;;
        "$tilde_prefix"*) resolved_path=$HOME/${configured_path#"$tilde_prefix"} ;;
        *) return 1 ;;
    esac
    [[ -r $resolved_path ]] || return 1
    content=
    IFS= read -r -d '' content 2>/dev/null <"$resolved_path" || true
    [[ -n $content ]] || return 1
    if [[ ${resolved_path##*/} == SKILL.md ]]; then
        [[ $content == '---'$'\n'* ]] || return 1
        body=${content#*$'\n---\n'}
        [[ $body != "$content" && -n $body ]] || return 1
        content=$body
    fi
    content='You are Scriptorium, not Codex.'$'\n\n'$content
    printf -v developer_instructions_value '%s' "$content"
}

review_pending_tools() {
    local pending_tools=$state_dir/tools-reconfigure-required
    local tools_manager=$repo_dir/scripts/tools-manager.sh
    local pending_names
    [[ -s $pending_tools && $(read_pref "$preferences_file" tools 0) == 1 ]] || return 0
    pending_names=$(paste -sd, "$pending_tools")
    printf 'scodex: new optional tools require your selection: %s\n' "$pending_names"
    if [[ -t 0 && -t 1 && -x $tools_manager ]]; then
        if "$tools_manager" configure --review "$pending_names"; then
            "$repo_dir/codex/scripts/render-agents.sh"
            rm -f -- "$pending_tools"
            load_tools_env
        else
            printf 'scodex: tool selection remains pending; Codex will continue\n' >&2
        fi
    else
        printf 'scodex: run `scodex tools configure` in a terminal to review the tool list\n'
    fi
}

review_system_tool_replacements() {
    local tools_manager=$repo_dir/scripts/tools-manager.sh names answer
    [[ -x $tools_manager && $(read_pref "$preferences_file" tools 0) == 1 ]] || return 0
    names=$("$tools_manager" system-replacements | paste -sd, -)
    [[ -n $names ]] || return 0
    printf 'scodex: system copies now available for locally managed tools: %s\n' "$names"
    if [[ -t 0 && -t 1 ]]; then
        read -r -p 'Remove the local copies and use the system versions? [Y/n] ' answer
        if [[ ${answer,,} != n && ${answer,,} != no ]]; then
            "$tools_manager" adopt-system
            "$repo_dir/codex/scripts/render-agents.sh"
            load_tools_env
            printf 'scodex: switched to the system versions\n'
        fi
    else
        printf 'scodex: run `scodex tools adopt-system` to remove the local copies\n'
    fi
}

valid_thread_id() {
    local thread_id=$1
    [[ ${#thread_id} -eq 36 && $thread_id != *[!0-9a-f-]* \
        && ${thread_id:8:1} == - && ${thread_id:13:1} == - \
        && ${thread_id:18:1} == - && ${thread_id:23:1} == - ]]
}

find_session_file() {
    local codex_home=$1 thread_id=$2
    find "$codex_home/sessions" -type f -name "rollout-*-$thread_id.jsonl" \
        -print -quit 2>/dev/null
}

is_root_session_meta() {
    local meta=$1
    if [[ $meta == *'"parent_thread_id":'* ]]; then
        [[ $meta == *'"parent_thread_id":null'* ]]
    else
        [[ $meta != *'"subagent"'* ]]
    fi
}

session_usage() {
    local session_file=$1 since=${2:-0}
    awk -v since="$since" '
        function number_after(value, key, copy) {
            copy = value
            sub("^.*\"" key "\"[[:space:]]*:[[:space:]]*", "", copy)
            sub("[^0-9].*$", "", copy)
            return copy ~ /^[0-9]+$/ ? copy + 0 : 0
        }
        function finish_task(delta_total, delta_cached) {
            if (!have_task_usage) return

            delta_total = current_total >= previous_task_total \
                ? current_total - previous_task_total : current_total
            delta_cached = current_cached >= previous_task_cached \
                ? current_cached - previous_task_cached : current_cached
            if (include_task) {
                total += delta_total
                cached += delta_cached
            }
            last_total = delta_total
            last_cached = delta_cached
            previous_task_total = current_total
            previous_task_cached = current_cached
            have_task_usage = 0
        }
        BEGIN { include_task = since == 0 }
        index($0, "\"task_started\"") {
            finish_task()
            started = number_after($0, "started_at")
            include_task = since == 0 || (started > 0 && started >= since)
            saw_task = 1
            next
        }
        index($0, "\"token_count\"") && index($0, "\"total_token_usage\"") {
            usage = $0
            sub("^.*\"total_token_usage\"[^{]*\\{", "", usage)
            sub("\\}.*$", "", usage)
            current_total = number_after(usage, "total_tokens")
            current_cached = number_after(usage, "cached_input_tokens")
            if (!saw_task) include_task = since == 0
            have_task_usage = 1
        }
        END {
            finish_task()
            printf "%d %d %d %d\n", total, cached, last_total, last_cached
        }
    ' "$session_file"
}

read_project_stats() {
    local stats_file=$PWD/.scriptorium/stats key=$1
    [[ -f $stats_file && ! -L $stats_file ]] || return 0
    sed -n "s/^${key}=//p" "$stats_file" | tail -n 1
}

format_number() {
    local value=$1 result= chunk
    while (( ${#value} > 3 )); do
        chunk=${value: -3}
        value=${value:0:${#value}-3}
        result=" $chunk$result"
    done
    printf '%s%s' "$value" "$result"
}

show_context_pressure() {
    local codex_home=${CODEX_HOME:-"$HOME/.codex"} thread_id=${CODEX_THREAD_ID:-}
    local session_file line input_tokens context_window percent pressure
    if ! valid_thread_id "$thread_id"; then
        printf '%s\n' 'context_pressure=unknown'
        return 0
    fi
    session_file=$(find_session_file "$codex_home" "$thread_id") || true
    if [[ ! -f $session_file ]]; then
        printf '%s\n' 'context_pressure=unknown'
        return 0
    fi
    line=$(awk 'index($0, "\"token_count\"") { latest=$0 } END { print latest }' \
        "$session_file")
    input_tokens=$(sed -n \
        's/.*"last_token_usage"[[:space:]]*:[[:space:]]*{"input_tokens"[[:space:]]*:[[:space:]]*\([0-9][0-9]*\).*/\1/p' \
        <<<"$line")
    context_window=$(sed -n \
        's/.*"model_context_window"[[:space:]]*:[[:space:]]*\([0-9][0-9]*\).*/\1/p' \
        <<<"$line")
    if [[ ! $input_tokens =~ ^[0-9]+$ || ! $context_window =~ ^[1-9][0-9]*$ ]]; then
        printf '%s\n' 'context_pressure=unknown'
        return 0
    fi
    percent=$(( input_tokens * 100 / context_window ))
    if (( percent < 55 )); then
        pressure=low
    elif (( percent < 75 )); then
        pressure=medium
    else
        pressure=high
    fi
    printf 'context_pressure=%s input_tokens=%s context_window=%s percent=%s\n' \
        "$pressure" "$input_tokens" "$context_window" "$percent"
}

show_stats() {
    local codex_home=${CODEX_HOME:-"$HOME/.codex"} thread_id=${CODEX_THREAD_ID:-}
    local session_file candidate meta cwd child_file child_line usage run_usage
    local main_total main_cached main_last main_last_cached child_total child_cached
    local run_started main_run=0 main_run_cached=0 child_run child_run_cached
    local first_input peak_input returned_output estimate
    local delegate_count=0 delegate_total=0 delegate_cached=0 delegate_run=0
    local delegate_run_cached=0 saved_context=0

    if ! valid_thread_id "$thread_id"; then
        thread_id=$(read_project_stats thread_id)
    fi
    if valid_thread_id "$thread_id"; then
        session_file=$(find_session_file "$codex_home" "$thread_id") || true
    else
        session_file=
        while IFS= read -r candidate; do
            meta=$(awk 'index($0, "\"session_meta\"") { print; exit }' "$candidate")
            cwd=$(sed -n 's/.*"cwd":"\([^"]*\)".*/\1/p' <<<"$meta")
            if is_root_session_meta "$meta" && [[ $cwd == "$PWD" ]]; then
                session_file=$candidate
                thread_id=$(sed -n 's/.*"id":"\([0-9a-f-]*\)".*/\1/p' <<<"$meta")
                break
            fi
        done < <(find "$codex_home/sessions" -type f -name 'rollout-*.jsonl' \
            -printf '%T@ %p\n' 2>/dev/null | sort -nr | cut -d' ' -f2-)
    fi
    if [[ ! -f ${session_file:-} ]] || ! valid_thread_id "$thread_id"; then
        printf 'Scriptorium usage\n\nNo session found for this project.\n'
        return 0
    fi

    usage=$(session_usage "$session_file" 0)
    read -r main_total main_cached main_last main_last_cached <<<"$usage"
    if [[ ! $main_total =~ ^[0-9]+$ || $main_total == 0 ]]; then
        printf 'Scriptorium usage\n\nNo token telemetry is available for this project.\n'
        return 0
    fi
    run_started=$(read_project_stats run_started_at)
    [[ $run_started =~ ^[0-9]+$ ]] || run_started=0
    if (( run_started > 0 )); then
        run_usage=$(session_usage "$session_file" "$run_started")
        read -r main_run main_run_cached _ _ <<<"$run_usage"
    fi

    while IFS= read -r child_file; do
        meta=$(awk 'index($0, "\"session_meta\"") { print; exit }' "$child_file")
        [[ $meta == *"\"parent_thread_id\":\"$thread_id\""* ]] || continue
        usage=$(session_usage "$child_file" 0)
        read -r child_total child_cached _ _ <<<"$usage"
        (( child_total > 0 )) || continue
        if (( run_started > 0 )); then
            run_usage=$(session_usage "$child_file" "$run_started")
            read -r child_run child_run_cached _ _ <<<"$run_usage"
        else
            child_run=0 child_run_cached=0
        fi
        first_input=$(sed -n 's/.*"last_token_usage"[^{]*{[^}]*"input_tokens"[[:space:]]*:[[:space:]]*\([0-9][0-9]*\).*/\1/p' "$child_file" | head -1)
        peak_input=$(sed -n 's/.*"last_token_usage"[^{]*{[^}]*"input_tokens"[[:space:]]*:[[:space:]]*\([0-9][0-9]*\).*/\1/p' "$child_file" | sort -n | tail -1)
        child_line=$(awk 'index($0, "\"token_count\"") { latest=$0 } END { print latest }' \
            "$child_file")
        returned_output=$(sed -n 's/.*"last_token_usage"[^{]*{[^}]*"output_tokens"[[:space:]]*:[[:space:]]*\([0-9][0-9]*\).*/\1/p' <<<"$child_line")
        [[ $first_input =~ ^[0-9]+$ ]] || first_input=0
        [[ $peak_input =~ ^[0-9]+$ ]] || peak_input=$first_input
        [[ $returned_output =~ ^[0-9]+$ ]] || returned_output=0
        estimate=$(( peak_input - first_input - returned_output ))
        (( estimate > 0 )) || estimate=0
        (( delegate_count += 1, delegate_total += child_total,
            delegate_cached += child_cached, delegate_run += child_run,
            delegate_run_cached += child_run_cached, saved_context += estimate ))
    done < <(find "$codex_home/sessions" -type f -name '*.jsonl' -print 2>/dev/null)

    printf 'Scriptorium usage\n'
    printf 'Thread: %s\n\n' "$thread_id"
    printf '  %-22s %15s %15s\n' 'Scope' 'Total tokens' 'Cached input'
    printf '  %-22s %15s %15s\n' 'Entire thread' \
        "$(format_number "$(( main_total + delegate_total ))")" \
        "$(format_number "$(( main_cached + delegate_cached ))")"
    if (( run_started > 0 )); then
        printf '  %-22s %15s %15s\n' 'Last scodex run' \
            "$(format_number "$(( main_run + delegate_run ))")" \
            "$(format_number "$(( main_run_cached + delegate_run_cached ))")"
    else
        printf '  %-22s %15s %15s\n' 'Last scodex run' 'not recorded' '-'
    fi
    printf '  %-22s %15s %15s\n' 'Last main-agent turn' \
        "$(format_number "$main_last")" "$(format_number "$main_last_cached")"
    printf '\nBreakdown\n'
    printf '  Main agent:             %15s tokens\n' "$(format_number "$main_total")"
    printf '  Delegates (%s sessions): %15s tokens\n' "$delegate_count" \
        "$(format_number "$delegate_total")"
    printf '  Context saved (estimate): %13s tokens\n' "$(format_number "$saved_context")"
    printf '\nContext saved is an estimate, not a billing reduction.\n'
}

record_project_run() {
    local codex_home=$1 run_started=$2 project_dir=$3 candidate meta cwd thread_id
    local marker_dir=$project_dir/.scriptorium marker_file tmp
    while IFS= read -r candidate; do
        meta=$(awk 'index($0, "\"session_meta\"") { print; exit }' "$candidate")
        is_root_session_meta "$meta" || continue
        cwd=$(sed -n 's/.*"cwd":"\([^"]*\)".*/\1/p' <<<"$meta")
        [[ $cwd == "$project_dir" ]] || continue
        thread_id=$(sed -n 's/.*"id":"\([0-9a-f-]*\)".*/\1/p' <<<"$meta")
        valid_thread_id "$thread_id" || continue
        if [[ -L $marker_dir ]]; then
            printf 'scodex: refusing to write project stats through symlink: %s\n' \
                "$marker_dir" >&2
            return 0
        fi
        mkdir -p -- "$marker_dir"
        marker_file=$marker_dir/stats
        [[ ! -L $marker_file ]] || return 0
        tmp=$(mktemp "$marker_dir/.stats.XXXXXX")
        printf 'version=1\nthread_id=%s\nrun_started_at=%s\n' \
            "$thread_id" "$run_started" >"$tmp"
        chmod 600 "$tmp"
        mv -- "$tmp" "$marker_file"
        return 0
    done < <(find "$codex_home/sessions" -type f -name 'rollout-*.jsonl' \
        -printf '%T@ %p\n' 2>/dev/null | sort -nr | cut -d' ' -f2-)
}

reconcile_tool_catalog() {
    local tools_manager=$repo_dir/scripts/tools-manager.sh
    if [[ -x $tools_manager && $(read_pref "$preferences_file" tools 0) == 1 ]]; then
        "$tools_manager" reconcile || true
    fi
}

configured_repo=$(read_pref "$preferences_file" repo_dir "")
if [[ -n $configured_repo ]]; then
    repo_dir=$configured_repo
    if [[ ! -d $repo_dir/.git ]]; then
        printf 'scodex: configured repository is invalid: %s\n' "$repo_dir" >&2
        exit 1
    fi
fi

case ${1:-} in
    context)
        show_context_pressure
        exit 0
        ;;
    stats)
        if (( $# != 1 )); then
            printf 'scodex: stats does not accept arguments.\n' >&2
            exit 2
        fi
        show_stats
        exit 0
        ;;
    update)
        printf 'scodex: `scodex update` was removed; start scodex in a terminal to install updates.\n' >&2
        exit 2
        ;;
    configure)
        shift
        "$repo_dir/install.sh" "$@"
        exit $?
        ;;
    uninstall)
        shift
        exec "$repo_dir/uninstall.sh" "$@"
        ;;
    tools)
        shift
        tools_manager=$repo_dir/scripts/tools-manager.sh
        if [[ -x $tools_manager ]]; then
            if [[ ${1:-} == status ]]; then
                printf 'scodex: `scodex tools status` was removed; use `scodex tools`.\n' >&2
                exit 2
            fi
            tools_action=${1:-status}
            "$tools_manager" "$@"
            case $tools_action in
                configure|update|remove|clear|adopt-system)
                    "$repo_dir/codex/scripts/render-agents.sh"
                    ;;
            esac
            exit 0
        fi
        printf 'scodex: tools manager is not available.\n'
        exit 1
        ;;
esac

case ${1:-} in
    --no-update)
        printf 'scodex: `--no-update` was removed; configure update checks with `scodex configure`.\n' >&2
        exit 2
        ;;
    --cheap|cheap|--normal|normal|--hard|hard)
        printf 'scodex: profile selectors were removed; scodex always uses Sol.\n' >&2
        exit 2
        ;;
esac

skip_update=${SCRIPTORIUM_INTERNAL_SKIP_UPDATE_CHECK:-0}
unset SCRIPTORIUM_INTERNAL_SKIP_UPDATE_CHECK
if [[ $skip_update != 1 ]] && [[ $(read_pref "$preferences_file" update_check "$(read_pref "$preferences_file" auto_update 1)") != 0 ]]; then
    update_status=0
    SCRIPTORIUM_LAUNCH_UPDATE=1 "$repo_dir/scripts/update-repository.sh" || update_status=$?
    if (( update_status == 10 )); then
        export SCRIPTORIUM_INTERNAL_SKIP_UPDATE_CHECK=1
        exec "$launcher_dir/scodex" "$@"
    fi
fi
load_tools_env

tools_manager=$repo_dir/scripts/tools-manager.sh
reconcile_tool_catalog
review_pending_tools
review_system_tool_replacements

if [[ -x $tools_manager ]]; then
    "$tools_manager" check || true
fi

if ! command -v codex >/dev/null 2>&1; then
    printf 'scodex: codex is not installed or is missing from PATH.\n' >&2
    exit 127
fi

run_started=$(date +%s)
project_dir=$PWD
status=0
shell_path=$(toml_basic_string "$PATH")
codex_args=(
    --profile scriptorium
    -c shell_environment_policy.inherit=all
    -c "shell_environment_policy.set.PATH=$shell_path"
)
developer_instructions_value=
if [[ $(read_pref "$preferences_file" developer_instructions 1) != 0 ]]; then
    developer_instructions_file=$(read_pref "$preferences_file" \
        developer_instructions_file "$repo_dir/codex/developer-instructions.md")
    if [[ $developer_instructions_file == "$repo_dir/.agents/skills/monke-language/SKILL.md" ]]; then
        developer_instructions_file="$repo_dir/codex/developer-instructions.md"
    fi
    if load_developer_instructions "$developer_instructions_file"; then
        developer_instructions_toml=$(toml_basic_string "$developer_instructions_value")
        codex_args+=( -c "developer_instructions=$developer_instructions_toml" )
    else
        printf 'scodex: developer instructions unavailable; continuing without them.\n' >&2
    fi
fi
codex "${codex_args[@]}" "$@" || status=$?
record_project_run "${CODEX_HOME:-$HOME/.codex}" "$run_started" "$project_dir"
exit "$status"
