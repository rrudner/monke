#!/usr/bin/env bash
set -euo pipefail

launcher_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
repo_dir=$(cd -- "$launcher_dir/.." && pwd)
config_dir=${XDG_CONFIG_HOME:-"$HOME/.config"}/scriptorium
state_dir=${XDG_STATE_HOME:-"$HOME/.local/state"}/scriptorium
preferences_file=$config_dir/preferences
if [[ -f $launcher_dir/scriptorium-preferences.sh ]]; then
    source "$launcher_dir/scriptorium-preferences.sh"
elif [[ -f $repo_dir/scripts/preferences.sh ]]; then
    source "$repo_dir/scripts/preferences.sh"
else
    printf 'scodex: managed preference parser is unavailable.\n' >&2
    exit 1
fi

review_pending_tools() {
    local pending_tools=$state_dir/tools-reconfigure-required
    local tools_manager=$repo_dir/scripts/tools-manager.sh
    local tools_env=$config_dir/tools-env.sh pending_names
    [[ -s $pending_tools && $(read_pref "$preferences_file" tools 0) == 1 ]] || return 0
    pending_names=$(paste -sd, "$pending_tools")
    printf 'scodex: new optional tools require your selection: %s\n' "$pending_names"
    if [[ -t 0 && -t 1 && -x $tools_manager ]]; then
        if "$tools_manager" configure --review "$pending_names"; then
            "$repo_dir/codex/scripts/render-agents.sh"
            rm -f -- "$pending_tools"
            source "$tools_env"
        else
            printf 'scodex: tool selection remains pending; Codex will continue\n' >&2
        fi
    else
        printf 'scodex: run `scodex tools configure` in a terminal to review the tool list\n'
    fi
}

valid_thread_id() {
    local thread_id=$1
    [[ ${#thread_id} -eq 36 && $thread_id != *[!0-9a-f-]* \
        && ${thread_id:8:1} == - && ${thread_id:13:1} == - \
        && ${thread_id:18:1} == - && ${thread_id:23:1} == - ]]
}

find_session_file() {
    local codex_home=$1 thread_id=$2
    find "$codex_home/sessions" -type f -name "rollout-*-$thread_id.jsonl" \
        -print -quit 2>/dev/null
}

show_context_pressure() {
    local codex_home=${CODEX_HOME:-"$HOME/.codex"} thread_id=${CODEX_THREAD_ID:-}
    local session_file line input_tokens context_window percent pressure
    if ! valid_thread_id "$thread_id"; then
        printf '%s\n' 'context_pressure=unknown'
        return 0
    fi
    session_file=$(find_session_file "$codex_home" "$thread_id") || true
    if [[ ! -f $session_file ]]; then
        printf '%s\n' 'context_pressure=unknown'
        return 0
    fi
    line=$(awk 'index($0, "\"token_count\"") { latest=$0 } END { print latest }' \
        "$session_file")
    input_tokens=$(sed -n \
        's/.*"last_token_usage"[[:space:]]*:[[:space:]]*{"input_tokens"[[:space:]]*:[[:space:]]*\([0-9][0-9]*\).*/\1/p' \
        <<<"$line")
    context_window=$(sed -n \
        's/.*"model_context_window"[[:space:]]*:[[:space:]]*\([0-9][0-9]*\).*/\1/p' \
        <<<"$line")
    if [[ ! $input_tokens =~ ^[0-9]+$ || ! $context_window =~ ^[1-9][0-9]*$ ]]; then
        printf '%s\n' 'context_pressure=unknown'
        return 0
    fi
    percent=$(( input_tokens * 100 / context_window ))
    if (( percent < 55 )); then
        pressure=low
    elif (( percent < 75 )); then
        pressure=medium
    else
        pressure=high
    fi
    printf 'context_pressure=%s input_tokens=%s context_window=%s percent=%s\n' \
        "$pressure" "$input_tokens" "$context_window" "$percent"
}

show_stats() {
    local codex_home=${CODEX_HOME:-"$HOME/.codex"} thread_id=${CODEX_THREAD_ID:-}
    local session_file candidate meta line main_total main_cached child_file
    local child_line child_total child_cached first_input peak_input returned_output estimate
    local delegate_count=0 delegate_total=0 delegate_cached=0 saved_context=0

    if valid_thread_id "$thread_id"; then
        session_file=$(find_session_file "$codex_home" "$thread_id") || true
    else
        session_file=
        while IFS= read -r candidate; do
            meta=$(awk 'index($0, "\"session_meta\"") { print; exit }' "$candidate")
            if [[ $meta == *'"parent_thread_id":null'* ]]; then
                session_file=$candidate
                thread_id=$(sed -n 's/.*"id":"\([0-9a-f-]*\)".*/\1/p' <<<"$meta")
                break
            fi
        done < <(find "$codex_home/sessions" -type f -name 'rollout-*.jsonl' \
            -printf '%T@ %p\n' 2>/dev/null | sort -nr | cut -d' ' -f2-)
    fi
    if [[ ! -f ${session_file:-} ]] || ! valid_thread_id "$thread_id"; then
        printf '%s\n' 'stats=unavailable reason=no-session'
        return 0
    fi

    line=$(awk 'index($0, "\"token_count\"") { latest=$0 } END { print latest }' \
        "$session_file")
    main_total=$(sed -n 's/.*"total_token_usage"[^{]*{[^}]*"total_tokens"[[:space:]]*:[[:space:]]*\([0-9][0-9]*\).*/\1/p' <<<"$line")
    main_cached=$(sed -n 's/.*"total_token_usage"[^{]*{[^}]*"cached_input_tokens"[[:space:]]*:[[:space:]]*\([0-9][0-9]*\).*/\1/p' <<<"$line")
    if [[ ! $main_total =~ ^[0-9]+$ ]]; then
        printf '%s\n' 'stats=unavailable reason=no-token-telemetry'
        return 0
    fi
    [[ $main_cached =~ ^[0-9]+$ ]] || main_cached=0

    while IFS= read -r child_file; do
        meta=$(awk 'index($0, "\"session_meta\"") { print; exit }' "$child_file")
        [[ $meta == *"\"parent_thread_id\":\"$thread_id\""* ]] || continue
        child_line=$(awk 'index($0, "\"token_count\"") { latest=$0 } END { print latest }' \
            "$child_file")
        child_total=$(sed -n 's/.*"total_token_usage"[^{]*{[^}]*"total_tokens"[[:space:]]*:[[:space:]]*\([0-9][0-9]*\).*/\1/p' <<<"$child_line")
        [[ $child_total =~ ^[0-9]+$ ]] || continue
        child_cached=$(sed -n 's/.*"total_token_usage"[^{]*{[^}]*"cached_input_tokens"[[:space:]]*:[[:space:]]*\([0-9][0-9]*\).*/\1/p' <<<"$child_line")
        [[ $child_cached =~ ^[0-9]+$ ]] || child_cached=0
        first_input=$(sed -n 's/.*"last_token_usage"[^{]*{[^}]*"input_tokens"[[:space:]]*:[[:space:]]*\([0-9][0-9]*\).*/\1/p' "$child_file" | head -1)
        peak_input=$(sed -n 's/.*"last_token_usage"[^{]*{[^}]*"input_tokens"[[:space:]]*:[[:space:]]*\([0-9][0-9]*\).*/\1/p' "$child_file" | sort -n | tail -1)
        returned_output=$(sed -n 's/.*"last_token_usage"[^{]*{[^}]*"output_tokens"[[:space:]]*:[[:space:]]*\([0-9][0-9]*\).*/\1/p' <<<"$child_line")
        [[ $first_input =~ ^[0-9]+$ ]] || first_input=0
        [[ $peak_input =~ ^[0-9]+$ ]] || peak_input=$first_input
        [[ $returned_output =~ ^[0-9]+$ ]] || returned_output=0
        estimate=$(( peak_input - first_input - returned_output ))
        (( estimate > 0 )) || estimate=0
        (( delegate_count += 1, delegate_total += child_total,
            delegate_cached += child_cached, saved_context += estimate ))
    done < <(find "$codex_home/sessions" -type f -name '*.jsonl' -print 2>/dev/null)

    printf 'Scriptorium stats\n'
    printf 'session=%s\n' "$thread_id"
    printf 'main_tokens=%s cached=%s\n' "$main_total" "$main_cached"
    printf 'delegate_sessions=%s delegate_tokens=%s cached=%s\n' \
        "$delegate_count" "$delegate_total" "$delegate_cached"
    printf 'estimated_context_saved=%s\n' "$saved_context"
    printf '%s\n' 'note=estimate-only-not-billing-savings'
}

reconcile_tool_catalog() {
    local tools_manager=$repo_dir/scripts/tools-manager.sh
    if [[ -x $tools_manager && $(read_pref "$preferences_file" tools 0) == 1 ]]; then
        "$tools_manager" reconcile || true
    fi
}

configured_repo=$(read_pref "$preferences_file" repo_dir "")
if [[ -n $configured_repo ]]; then
    repo_dir=$configured_repo
    if [[ ! -d $repo_dir/.git ]]; then
        printf 'scodex: configured repository is invalid: %s\n' "$repo_dir" >&2
        exit 1
    fi
fi

case ${1:-} in
    context)
        show_context_pressure
        exit 0
        ;;
    stats)
        show_stats
        exit 0
        ;;
    update)
        SCRIPTORIUM_MANUAL_UPDATE=1 \
            SCRIPTORIUM_SKIP_SNOOZE_CHECK=1 \
            "$repo_dir/scripts/update-repository.sh" apply || true
        reconcile_tool_catalog
        review_pending_tools
        exit 0
        ;;
    configure)
        shift
        "$repo_dir/install.sh" "$@"
        exit $?
        ;;
    uninstall)
        shift
        exec "$repo_dir/uninstall.sh" "$@"
        ;;
    tools)
        shift
        tools_manager=$repo_dir/scripts/tools-manager.sh
        if [[ -x $tools_manager ]]; then
            tools_action=${1:-status}
            "$tools_manager" "$@"
            case $tools_action in
                configure|update|remove|clear)
                    "$repo_dir/codex/scripts/render-agents.sh"
                    ;;
            esac
            exit 0
        fi
        printf 'scodex: tools manager is not available.\n'
        exit 1
        ;;
esac

skip_update=0
if [[ ${1:-} == --no-update ]]; then
    skip_update=1
    shift
fi

profile=hard
case ${1:-} in
    --cheap|cheap) profile=cheap; shift ;;
    --normal|normal) profile=normal; shift ;;
    --hard|hard) profile=hard; shift ;;
esac

tools_env=$config_dir/tools-env.sh
if [[ -f $tools_env ]]; then
    source "$tools_env"
else
    export SCRIPTORIUM_ACTIVE=1 SCRIPTORIUM_TOOLS=
fi

if (( ! skip_update )) && [[ $(read_pref "$preferences_file" update_check "$(read_pref "$preferences_file" auto_update 1)") != 0 ]]; then
    SCRIPTORIUM_MANUAL_UPDATE=1 "$repo_dir/scripts/update-repository.sh" check || true
fi

tools_manager=$repo_dir/scripts/tools-manager.sh
reconcile_tool_catalog
review_pending_tools

if [[ -x $tools_manager ]]; then
    "$tools_manager" check || true
fi

if ! command -v codex >/dev/null 2>&1; then
    printf 'scodex: codex is not installed or is missing from PATH.\n' >&2
    exit 127
fi

exec codex --profile "scriptorium-$profile" "$@"
